<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SQL-Server-Migrationen aller Module. Migrationen sind providerspezifisch: Postgres behält seine in den Modulen,
    SQL Server hat dieses Projekt (UseOdmDatabase lädt es nur bei Database:Provider = SqlServer).
    Erzeugen: scripts/ef-sqlserver.ps1 bzw. scripts/ef-sqlserver.sh
  -->
  <ItemGroup>
    <ProjectReference Include="..\Odm.SharedKernel\Odm.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Identity\Odm.Modules.Identity\Odm.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Devices\Odm.Modules.Devices\Odm.Modules.Devices.csproj" />
    <ProjectReference Include="..\Modules\Agents\Odm.Modules.Agents\Odm.Modules.Agents.csproj" />
    <ProjectReference Include="..\Modules\Software\Odm.Modules.Software\Odm.Modules.Software.csproj" />
    <ProjectReference Include="..\Modules\OsUpdates\Odm.Modules.OsUpdates\Odm.Modules.OsUpdates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
