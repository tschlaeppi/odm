# Kopieren nach .env und Werte setzen
ODM_JWT_SECRET=bitte-mindestens-32-zeichen-langes-geheimnis-setzen
ODM_ADMIN_USER=admin
ODM_ADMIN_PASSWORD=bitte-aendern
ODM_DB_PASSWORD=bitte-aendern
# Schlüssel für gespeicherte Secrets: openssl rand -base64 32  (sicher aufbewahren; ohne ihn sind Secrets unlesbar)
ODM_SECRETS_KEY=
ODM_S3_PASSWORD=bitte-aendern-min-8-zeichen

# Optional: Agent-Selbstaktualisierung (Standard: aus)
# Mode: Off | Latest (neueste Version, nur aufwärts) | Pinned (genau ODM_AGENT_UPDATE_VERSION, auch Rückstufung)
ODM_AGENT_UPDATE_MODE=Off
ODM_AGENT_UPDATE_VERSION=
# Anteil der Geräte, die das Update bekommen (0-100); schrittweise erhöhen
ODM_AGENT_UPDATE_PERCENT=100
# Öffentliche Adresse des Servers für die Installationsskripte, z. B. https://odm.example.org (leer = aus der Anfrage)
ODM_PUBLIC_URL=
